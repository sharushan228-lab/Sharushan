rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidCompletedIds(listVal) {
      return listVal is list
        && listVal.size() <= 500
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 32));
    }

    function isValidLearnerProgress(data) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'grade',
          'preferredSubject',
          'stars',
          'streak',
          'completedIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'grade',
          'preferredSubject',
          'stars',
          'streak',
          'completedIds',
          'createdAt',
          'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.grade is int
        && data.grade >= 1
        && data.grade <= 6
        && data.preferredSubject is string
        && data.preferredSubject.size() <= 16
        && data.preferredSubject in ['Mathe', 'Deutsch', 'Französisch', 'Englisch', 'NMG']
        && data.stars is int
        && data.stars >= 0
        && data.stars <= 100000
        && data.streak is int
        && data.streak >= 0
        && data.streak <= 10000
        && isValidCompletedIds(data.completedIds)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/private/progress {
      allow get: if isEmailVerified() && isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isEmailVerified()
        && isOwner(userId)
        && isValidId(userId)
        && isValidLearnerProgress(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isEmailVerified()
        && isOwner(userId)
        && isValidId(userId)
        && isValidLearnerProgress(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'grade',
          'preferredSubject',
          'stars',
          'streak',
          'completedIds',
          'updatedAt'
        ]);
      allow delete: if isEmailVerified() && isOwner(userId) && isValidId(userId);
    }
  }
}
